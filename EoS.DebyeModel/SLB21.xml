        <let name="F0" unit="J/mol">-975.0e3</let>
        <let name="V0" unit="m^3/mol">49.02e-6</let>
        <let name="K0" unit="Pa">161.0e9</let>
        <let name="K0_p" unit="1">4.0</let>
        <let name="θ0" unit="K">454.0</let>
        <let name="γ0" unit="1">1.45</let>
        <let name="q0" unit="1">1.5</let>
        <let name="G0" unit="Pa">59.0e9</let>
        <let name="G0_p" unit="1">1.4</let>
        <let name="η0" unit="1">0.1</let>
