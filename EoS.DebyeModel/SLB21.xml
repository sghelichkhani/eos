      <let name="F0" unit="J/mol">-1994.0e3</let>
      <let name="V0" unit="m^3/mol">53.87e-6</let>
      <let name="K0" unit="Pa">53.0e9</let>
      <let name="K0_p" unit="1">4.0</let>
      <let name="θ0" unit="K">744.0</let>
      <let name="γ0" unit="1">0.70</let>
      <let name="q0" unit="1">1.0</let>
      <let name="G0" unit="Pa">31.0e9</let>
      <let name="G0_p" unit="1">1.3</let>
      <let name="η0" unit="1">0.6</let>
    </phase>
  </phase>

