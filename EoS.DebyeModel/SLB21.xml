        <let name="F0" unit="J/mol">-1774.0e3</let>
        <let name="V0" unit="m^3/mol">37.22e-6</let>
        <let name="K0" unit="Pa">213.0e9</let>
        <let name="K0_p" unit="1">4.1</let>
        <let name="θ0" unit="K">734.0</let>
        <let name="γ0" unit="1">1.57</let>
        <let name="q0" unit="1">1.0</let>
        <let name="G0" unit="Pa">160.0e9</let>
        <let name="G0_p" unit="1">1.9</let>
        <let name="η0" unit="1">2.3</let>
      </phase>
    </phase>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="nacf">
      <blurb>Na-Ca-Ferrite</blurb>
      <formula>(Na)(Si)AlO4</formula>

      <let name="F0" unit="J/mol">-1835.0e3</let>
      <let name="V0" unit="m^3/mol">36.27e-6</let>
      <let name="K0" unit="Pa">220.0e9</let>
