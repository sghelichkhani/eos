    </phase>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="anao">
      <blurb>Alpha NaAlO2</blurb>
      <formula>(Na)2(Al)2O4</formula>

      <let name="F0" unit="J/mol">-2115.0e3</let>
