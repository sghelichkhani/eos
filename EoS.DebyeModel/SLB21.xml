      <let name="F0" unit="J/mol">-2278.0e3</let>
      <let name="V0" unit="m^3/mol">44.98e-6</let>
      <let name="K0" unit="Pa">161.0e9</let>
      <let name="K0_p" unit="1">3.9</let>
