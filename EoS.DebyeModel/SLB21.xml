    </interaction>
    <interaction unit="J/mol" value="120.0e3">
      <phase ref="pe" /><phase ref="anao" />
    </interaction>
    <interaction unit="J/mol" value="120.0e3">
      <phase ref="wu" /><phase ref="anao" />
    </interaction>
  </phase>

  <!--
    Ca-Ferrite solution:
    *  Mg <-> Fe substitution on site 1
    *  NaSi <-> MgAl coupled substitution on site 1 and 2
    *  Al,Si disordered on site 2
  -->
  <phase type="EoS.Phases.RegularSolution, EoS.Core" id="cf">
    <blurb>Ca-Ferrite</blurb>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="mgcf">
