        <blurb>Fe-NAL-phase (no Landau)</blurb>
        <formula>(Fe)2(Al0.833333333333333Si0.166666666666667)6NaO12</formula>

        <let name="F0" unit="J/mol">-5475.0e3</let>
        <let name="V0" unit="m^3/mol">112.05e-6</let>
        <let name="K0" unit="Pa">204.0e9</let>
        <let name="K0_p" unit="1">4.3</let>
        <let name="θ0" unit="K">795.0</let>
        <let name="γ0" unit="1">1.43</let>
        <let name="q0" unit="1">1.0</let>
        <let name="G0" unit="Pa">150.0e9</let>
        <let name="G0_p" unit="1">1.7</let>
        <let name="η0" unit="1">2.7</let>
      </phase>
    </phase>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="nnal">
      <blurb>Na-NAL-phase</blurb>
