<module xmlns="http://chust.org/eos" id="SLB11">
  <blurb>
    Thermodynamic dataset taken from
    Stixrude, L.; Lithgow-Bertelloni, C.
    "Thermodynamics of mantle minerals -- II. Phase equilibria"
    Geophysical Journal International, 2011, 184, 1180-1213
  </blurb>

  <let name="T0" unit="K">300.0</let>

  <let name="allows-negative-components">False</let>
  <let name="excludes-endmember-configuration-entropy">False</let>
  <let name="transparent-fallback">False</let>

  <!--
    Feldspar solution:
    *  CaAl <-> NaSi coupled substitution on site 1 and 2
    *  Al,Si ordered on site 2
    *  Al,Si disorder on site 3 in albite
    => no entropy contribution from site 1 and 2
  -->
  <phase type="EoS.Phases.RegularSolution, EoS.Core" id="plg">
    <blurb>Feldspar</blurb>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="an">
      <blurb>Anorthite</blurb>
      <formula>(Ca)Al2Si2O8</formula>

      <let name="F0" unit="J/mol">-4014.619e3</let>
      <let name="V0" unit="m^3/mol">100.610e-6</let>
      <let name="K0" unit="Pa">84.08915e9</let>
      <let name="K0_p" unit="1">4.0</let>
      <let name="θ0" unit="K">752.3911</let>
      <let name="γ0" unit="1">0.39241</let>
      <let name="q0" unit="1">1.0</let>
      <let name="G0" unit="Pa">39.9e9</let>
      <let name="G0_p" unit="1">1.09134</let>
      <let name="η0" unit="1">1.6254</let>
    </phase>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="ab">
      <blurb>Albite</blurb>
      <formula>(Na)AlSi3O8</formula>

      <let name="F0" unit="J/mol">-3718.799e3</let>
      <let name="V0" unit="m^3/mol">100.4520e-6</let>
      <let name="K0" unit="Pa">59.76162e9</let>
      <let name="K0_p" unit="1">4.0</let>
      <let name="θ0" unit="K">713.7824</let>
      <let name="γ0" unit="1">0.56704</let>
      <let name="q0" unit="1">1.0</let>
      <let name="G0" unit="Pa">36e9</let>
      <let name="G0_p" unit="1">1.3855</let>
      <let name="η0" unit="1">1.04208</let>
    </phase>

    <interaction unit="J/mol" value="26.0e3">
      <phase ref="an" /><phase ref="ab" />
    </interaction>
  </phase>

  <!--
    Spinel solution:
    *  Mg <-> Fe substitution
    *  Mg,Al and Fe,Al ordered
  -->
  <phase type="EoS.Phases.RegularSolution, EoS.Core" id="sps">
    <blurb>Spinel</blurb>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="sp">
      <blurb>Spinel</blurb>
      <formula>(Mg0.125Al0.875)8(Mg0.75Al0.25)4O16</formula>

      <let name="F0" unit="J/mol">-8667.568e3</let>
      <let name="V0" unit="m^3/mol">159.0480e-6</let>
      <let name="K0" unit="Pa">196.9428e9</let>
      <let name="K0_p" unit="1">5.68282</let>
      <let name="θ0" unit="K">842.8104</let>
      <let name="γ0" unit="1">1.02283</let>
      <let name="q0" unit="1">2.71208</let>
      <let name="G0" unit="Pa">108.5e9</let>
      <let name="G0_p" unit="1">0.37303</let>
      <let name="η0" unit="1">2.66282</let>
    </phase>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="hc">
      <blurb>Hercynite</blurb>
      <formula>(Fe0.125Al0.875)8(Fe0.75Al0.25)4O16</formula>

      <let name="F0" unit="J/mol">-7324.009e3</let>
      <let name="V0" unit="m^3/mol">163.3720e-6</let>
      <let name="K0" unit="Pa">208.8965e9</let>
      <let name="K0_p" unit="1">5.68282</let>
      <let name="θ0" unit="K">763.231</let>
      <let name="γ0" unit="1">1.21719</let>
      <let name="q0" unit="1">2.71208</let>
      <let name="G0" unit="Pa">84.5e9</let>
      <let name="G0_p" unit="1">0.37303</let>
      <let name="η0" unit="1">2.768</let>
    </phase>

    <interaction unit="J/mol" value="5.0e3">
      <phase ref="sp" /><phase ref="hc" />
    </interaction>
  </phase>

  <!--
    Olivine solution:
    *  Mg <-> Fe substitution
  -->
  <phase type="EoS.Phases.RegularSolution, EoS.Core" id="ol">
    <blurb>Olivine</blurb>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="fo">
      <blurb>Forsterite</blurb>
      <formula>(Mg)2SiO4</formula>

      <let name="F0" unit="J/mol">-2055.403e3</let>
      <let name="V0" unit="m^3/mol">43.6030e-6</let>
      <let name="K0" unit="Pa">127.9555e9</let>
      <let name="K0_p" unit="1">4.21796</let>
      <let name="θ0" unit="K">809.1703</let>
      <let name="γ0" unit="1">0.99282</let>
      <let name="q0" unit="1">2.10672</let>
      <let name="G0" unit="Pa">81.59999e9</let>
      <let name="G0_p" unit="1">1.46257</let>
      <let name="η0" unit="1">2.29972</let>
    </phase>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="fa">
      <blurb>Fayalite</blurb>
      <formula>(Fe)2SiO4</formula>

      <let name="F0" unit="J/mol">-1370.519e3</let>
      <let name="V0" unit="m^3/mol">46.290e-6</let>
      <let name="K0" unit="Pa">134.9622e9</let>
      <let name="K0_p" unit="1">4.21796</let>
      <let name="θ0" unit="K">618.7007</let>
      <let name="γ0" unit="1">1.06023</let>
      <let name="q0" unit="1">3.6466</let>
      <let name="G0" unit="Pa">50.89999e9</let>
      <let name="G0_p" unit="1">1.46257</let>
      <let name="η0" unit="1">1.02497</let>
    </phase>

    <interaction unit="J/mol" value="7.6e3">
      <phase ref="fo" /><phase ref="fa" />
    </interaction>
  </phase>

  <!--
    Wadsleyite solution:
    *  Mg <-> Fe substitution
  -->
  <phase type="EoS.Phases.RegularSolution, EoS.Core" id="wa">
    <blurb>Wadsleyite</blurb>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="mgwa">
      <blurb>Mg-Wadsleyite</blurb>
      <formula>(Mg)2SiO4</formula>

      <let name="F0" unit="J/mol">-2027.837e3</let>
      <let name="V0" unit="m^3/mol">40.5150e-6</let>
      <let name="K0" unit="Pa">168.6948e9</let>
      <let name="K0_p" unit="1">4.3229</let>
      <let name="θ0" unit="K">843.4973</let>
      <let name="γ0" unit="1">1.2061</let>
      <let name="q0" unit="1">2.0188</let>
      <let name="G0" unit="Pa">112.0e9</let>
      <let name="G0_p" unit="1">1.44424</let>
      <let name="η0" unit="1">2.63683</let>
    </phase>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="fewa">
      <blurb>Fe-Wadsleyite</blurb>
      <formula>(Fe)2SiO4</formula>

      <let name="F0" unit="J/mol">-1364.668e3</let>
      <let name="V0" unit="m^3/mol">42.80e-6</let>
      <let name="K0" unit="Pa">168.591e9</let>
      <let name="K0_p" unit="1">4.3229</let>
      <let name="θ0" unit="K">665.4492</let>
      <let name="γ0" unit="1">1.2061</let>
      <let name="q0" unit="1">2.0188</let>
      <let name="G0" unit="Pa">72e9</let>
      <let name="G0_p" unit="1">1.44424</let>
      <let name="η0" unit="1">1.04017</let>
    </phase>

    <interaction unit="J/mol" value="16.5e3">
      <phase ref="mgwa" /><phase ref="fewa" />
    </interaction>
  </phase>

  <!--
    Ringwoodite solution:
    *  Mg <-> Fe substitution
  -->
  <phase type="EoS.Phases.RegularSolution, EoS.Core" id="ri">
    <blurb>Ringwoodite</blurb>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="mgri">
      <blurb>Mg-Ringwoodite</blurb>
      <formula>(Mg)2SiO4</formula>

      <let name="F0" unit="J/mol">-2017.557e3</let>
      <let name="V0" unit="m^3/mol">39.4930e-6</let>
      <let name="K0" unit="Pa">184.9009e9</let>
      <let name="K0_p" unit="1">4.22035</let>
      <let name="θ0" unit="K">877.7094</let>
      <let name="γ0" unit="1">1.10791</let>
      <let name="q0" unit="1">2.3914</let>
      <let name="G0" unit="Pa">123.0e9</let>
      <let name="G0_p" unit="1">1.35412</let>
      <let name="η0" unit="1">2.30461</let>
    </phase>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="feri">
      <blurb>Fe-Ringwoodite</blurb>
      <formula>(Fe)2SiO4</formula>

      <let name="F0" unit="J/mol">-1362.772e3</let>
      <let name="V0" unit="m^3/mol">41.860e-6</let>
      <let name="K0" unit="Pa">213.412e9</let>
      <let name="K0_p" unit="1">4.22035</let>
      <let name="θ0" unit="K">677.7177</let>
      <let name="γ0" unit="1">1.27193</let>
      <let name="q0" unit="1">2.3914</let>
      <let name="G0" unit="Pa">92.0e9</let>
      <let name="G0_p" unit="1">1.35412</let>
      <let name="η0" unit="1">1.77249</let>
    </phase>

    <interaction unit="J/mol" value="9.1e3">
      <phase ref="mgri" /><phase ref="feri" />
    </interaction>
  </phase>

  <!--
    Orthopyroxene solution:
    *  Fe <-> Mg <-> Ca substitution on site 1
    *  MgSi <-> AlAl coupled substitution on site 2 and 3
    *  Al,Si disorder on site 3
    => assuming no entropy contribution from site 2
  -->
  <phase type="EoS.Phases.RegularSolution, EoS.Core" id="opx">
    <blurb>Orthopyroxene</blurb>
    <let name="allows-negative-components">True</let>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="en">
      <blurb>Enstatite</blurb>
      <formula>(Mg)(Mg)Si2O6</formula>

      <let name="F0" unit="J/mol">-2913.596e3</let>
      <let name="V0" unit="m^3/mol">62.6760e-6</let>
      <let name="K0" unit="Pa">107.0768e9</let>
      <let name="K0_p" unit="1">7.02751</let>
      <let name="θ0" unit="K">812.1848</let>
      <let name="γ0" unit="1">0.78479</let>
      <let name="q0" unit="1">3.43846</let>
      <let name="G0" unit="Pa">76.8e9</let>
      <let name="G0_p" unit="1">1.54596</let>
      <let name="η0" unit="1">2.50453</let>
    </phase>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="fs">
      <blurb>Ferrosilite</blurb>
      <formula>(Fe)(Fe)Si2O6</formula>

      <let name="F0" unit="J/mol">-2225.718e3</let>
      <let name="V0" unit="m^3/mol">65.9410e-6</let>
      <let name="K0" unit="Pa">100.5386e9</let>
      <let name="K0_p" unit="1">7.02751</let>
      <let name="θ0" unit="K">674.4769</let>
      <let name="γ0" unit="1">0.71889</let>
      <let name="q0" unit="1">3.43846</let>
      <let name="G0" unit="Pa">52.0e9</let>
      <let name="G0_p" unit="1">1.54596</let>
      <let name="η0" unit="1">1.07706</let>
    </phase>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="mgts">
      <blurb>Mg-Tschermak</blurb>
      <formula>(Mg)(Al)SiAlO6</formula>

      <let name="F0" unit="J/mol">-3002.47e3</let>
      <let name="V0" unit="m^3/mol">59.140e-6</let>
      <let name="K0" unit="Pa">107.0768e9</let>
      <let name="K0_p" unit="1">7.02751</let>
      <let name="θ0" unit="K">783.8404</let>
      <let name="γ0" unit="1">0.78479</let>
      <let name="q0" unit="1">3.43846</let>
      <let name="G0" unit="Pa">95.95086e9</let>
      <let name="G0_p" unit="1">1.54596</let>
      <let name="η0" unit="1">2.49099</let>
    </phase>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="odi">
      <blurb>Ortho-Diopside</blurb>
      <formula>(Ca)(Mg)Si2O6</formula>

      <let name="F0" unit="J/mol">-3015.827e3</let>
      <let name="V0" unit="m^3/mol">68.0540e-6</let>
      <let name="K0" unit="Pa">107.0768e9</let>
      <let name="K0_p" unit="1">7.02751</let>
      <let name="θ0" unit="K">744.6988</let>
      <let name="γ0" unit="1">0.78479</let>
      <let name="q0" unit="1">3.43846</let>
      <let name="G0" unit="Pa">58.45895e9</let>
      <let name="G0_p" unit="1">1.54596</let>
      <let name="η0" unit="1">1.36161</let>
    </phase>

    <interaction unit="J/mol" value="32.1e3">
      <phase ref="en" /><phase ref="odi" />
    </interaction>
    <interaction unit="J/mol" value="48.0e3">
      <phase ref="mgts" /><phase ref="odi" />
    </interaction>
  </phase>

  <!--
    Clinopyroxene solution:
    *  Mg <-> Ca substitution on site 1
    *  Mg2 <-> NaAl coupled substitution on site 1 and 2
    *  Mg <-> Fe substitution on site 2
    *  MgSi2 <-> Al2Si coupled substitution on site 2 and 3
    *  Al,Si disorder on site 3
    => assuming no entropy contribution from site 2
  -->
  <phase type="EoS.Phases.RegularSolution, EoS.Core" id="cpx">
    <blurb>Clinopyroxene</blurb>
    <let name="allows-negative-components">True</let>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="di">
      <blurb>Diopside</blurb>
      <formula>(Ca)(Mg)(Si)2O6</formula>

      <let name="F0" unit="J/mol">-3029.531e3</let>
      <let name="V0" unit="m^3/mol">66.0390e-6</let>
      <let name="K0" unit="Pa">112.2413e9</let>
      <let name="K0_p" unit="1">5.23885</let>
      <let name="θ0" unit="K">781.6146</let>
      <let name="γ0" unit="1">0.95873</let>
      <let name="q0" unit="1">1.52852</let>
      <let name="G0" unit="Pa">67.0e9</let>
      <let name="G0_p" unit="1">1.37293</let>
      <let name="η0" unit="1">1.57351</let>
    </phase>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="he">
      <blurb>Hedenbergite</blurb>
      <formula>(Ca)(Fe)(Si)2O6</formula>

      <let name="F0" unit="J/mol">-2677.33e3</let>
      <let name="V0" unit="m^3/mol">67.8670e-6</let>
      <let name="K0" unit="Pa">119.2555e9</let>
      <let name="K0_p" unit="1">5.23885</let>
      <let name="θ0" unit="K">701.5851</let>
      <let name="γ0" unit="1">0.93516</let>
      <let name="q0" unit="1">1.52852</let>
      <let name="G0" unit="Pa">61.0e9</let>
      <let name="G0_p" unit="1">1.17647</let>
      <let name="η0" unit="1">1.5703</let>
    </phase>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="cen">
      <blurb>Clinoenstatite</blurb>
      <formula>(Mg)(Mg)(Si)2O6</formula>

      <let name="F0" unit="J/mol">-2905.918e3</let>
      <let name="V0" unit="m^3/mol">62.50e-6</let>
      <let name="K0" unit="Pa">112.2413e9</let>
      <let name="K0_p" unit="1">5.23885</let>
      <let name="θ0" unit="K">805.0547</let>
      <let name="γ0" unit="1">0.95873</let>
      <let name="q0" unit="1">1.52852</let>
      <let name="G0" unit="Pa">79.49686e9</let>
      <let name="G0_p" unit="1">1.62901</let>
      <let name="η0" unit="1">1.69074</let>
    </phase>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="cats">
      <blurb>Ca-Tschermak</blurb>
      <formula>(Ca)(Al)(Si0.5Al0.5)2O6</formula>

      <let name="F0" unit="J/mol">-3120.253e3</let>
      <let name="V0" unit="m^3/mol">63.5740e-6</let>
      <let name="K0" unit="Pa">112.2413e9</let>
      <let name="K0_p" unit="1">5.23885</let>
      <let name="θ0" unit="K">803.6626</let>
      <let name="γ0" unit="1">0.78126</let>
      <let name="q0" unit="1">1.52852</let>
      <let name="G0" unit="Pa">75.16066e9</let>
      <let name="G0_p" unit="1">1.54016</let>
      <let name="η0" unit="1">1.9672</let>
    </phase>
    <size value="3.5">
      <phase ref="cats" />
    </size>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="jd">
      <blurb>Jadeite</blurb>
      <formula>(Na)(Al)(Si)2O6</formula>

      <let name="F0" unit="J/mol">-2855.192e3</let>
      <let name="V0" unit="m^3/mol">60.5080e-6</let>
      <let name="K0" unit="Pa">142.2873e9</let>
      <let name="K0_p" unit="1">5.23885</let>
      <let name="θ0" unit="K">820.7623</let>
      <let name="γ0" unit="1">0.903</let>
      <let name="q0" unit="1">0.39234</let>
      <let name="G0" unit="Pa">85.0e9</let>
      <let name="G0_p" unit="1">1.37398</let>
      <let name="η0" unit="1">2.18453</let>
    </phase>

    <interaction unit="J/mol" value="24.7e3">
      <phase ref="di" /><phase ref="cen" />
    </interaction>
    <interaction unit="J/mol" value="26.0e3">
      <phase ref="di" /><phase ref="cats" />
    </interaction>
    <interaction unit="J/mol" value="24.3e3">
      <phase ref="di" /><phase ref="jd" />
    </interaction>
    <interaction unit="J/mol" value="24.7e3">
      <phase ref="cen" /><phase ref="he" />
    </interaction>
    <interaction unit="J/mol" value="60.6e3">
      <phase ref="cen" /><phase ref="cats" />
    </interaction>
    <interaction unit="J/mol" value="10.0e3">
      <phase ref="cats" /><phase ref="jd" />
    </interaction>
  </phase>

  <!--
    HP-Clinopyroxene solution:
    *  Mg <-> Fe substitution
  -->
  <phase type="EoS.Phases.RegularSolution, EoS.Core" id="hpcpx">
    <blurb>HP-Clinopyroxene</blurb>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="hpcen">
      <blurb>HP-Clinoenstatite</blurb>
      <formula>(Mg)2Si2O6</formula>

      <let name="F0" unit="J/mol">-2905.788e3</let>
      <let name="V0" unit="m^3/mol">60.760e-6</let>
      <let name="K0" unit="Pa">116.0254e9</let>
      <let name="K0_p" unit="1">6.23685</let>
      <let name="θ0" unit="K">824.4439</let>
      <let name="γ0" unit="1">1.12473</let>
      <let name="q0" unit="1">0.20401</let>
      <let name="G0" unit="Pa">87.92717e9</let>
      <let name="G0_p" unit="1">1.84119</let>
      <let name="η0" unit="1">2.14181</let>
    </phase>

    <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="hpcfs">
      <blurb>HP-Clinoferrosilite</blurb>
      <formula>(Fe)2Si2O6</formula>

      <let name="F0" unit="J/mol">-2222.183e3</let>
      <let name="V0" unit="m^3/mol">63.854130e-6</let>
      <let name="K0" unit="Pa">116.0254e9</let>
      <let name="K0_p" unit="1">6.23685</let>
      <let name="θ0" unit="K">691.564</let>
      <let name="γ0" unit="1">1.12473</let>
      <let name="q0" unit="1">0.20401</let>
      <let name="G0" unit="Pa">70.62309e9</let>
      <let name="G0_p" unit="1">1.84119</let>
      <let name="η0" unit="1">0.79216</let>
    </phase>
  </phase>

  <phase type="EoS.DebyeModel.DebyeSolid, EoS.DebyeModel" id="capv">
    <blurb>Ca-Perovskite</blurb>
    <formula>CaSiO3</formula>

    <let name="F0" unit="J/mol">-1463.358e3</let>
    <let name="V0" unit="m^3/mol">27.450e-6</let>
